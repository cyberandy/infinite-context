    """
    return base_html(body, ca)

def slide_09():
    """Act II — Quantization Landscape"""
    grid = generate_rule90_grid(rows=15, cols=50)
    ca = ca_grid_to_svg(grid, cell_size=10, opacity=0.05, x_offset=0, y_offset=850)
    body = f"""
    <div class="section-label">Act II — The Compression Solution</div>
    <h1 class="headline">The Quantization Landscape</h1>
    <table style="margin-top:32px;">
      <tr style="background:{TOKENS['gray_light']};">
        <th>Algorithm</th><th>Unbiased Inner Product</th><th>Zero Codebook</th><th>GPU Friendly</th><th>Data-Oblivious</th>
      </tr>
      <tr style="font-size:16px; color:{TOKENS['gray_dark']};">
        <td style="font-weight:700;">What it means →</td><td>Accurate relevance</td><td>No re-training per corpus</td><td>Real-time indexing</td><td>Works on any content</td>
      </tr>
      <tr><td>Product Quantization</td><td style="color:{TOKENS['red']};">✗</td><td style="color:{TOKENS['red']};">✗</td><td style="color:{TOKENS['red']};">✗</td><td style="color:{TOKENS['red']};">✗</td></tr>
      <tr><td>OPQ / RQ</td><td style="color:{TOKENS['red']};">✗</td><td style="color:{TOKENS['red']};">✗</td><td>✓</td><td style="color:{TOKENS['red']};">✗</td></tr>
