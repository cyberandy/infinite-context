#!/usr/bin/env python3
"""
Generate 19 presentation slides as PNG files using HTML/CSS rendering.

Design system: Müller-Brockmann Swiss International Typographic Style
with implicit Cellular Automata rule patterns as visual substrate.

Requires: playwright (pip install playwright && playwright install chromium)

Usage:
    python generate_slides_v5.py [--only N] [--preview]
"""

import argparse
import asyncio
import sys
from pathlib import Path

# ── Slide Definitions ──
# Each slide: (filename, act, html_generator_function_name)

SLIDES_DIR = Path("slides_v5")

# ── Design Tokens ──
TOKENS = {
    "bg": "#FFFFFF",
    "fg": "#000000",
    "red": "#E63329",      # Swiss red
    "gray": "#B0B0B0",     # Cool gray
    "gray_light": "#E8E8E8",
    "gray_dark": "#4A4A4A",
    "blue": "#2D5BFF",     # Accent for data
    "font": "'Helvetica Neue', 'Helvetica', 'Arial', sans-serif",
    "width": 1920,
    "height": 1080,
}

# ── Rule 30 Pattern (Chaos) — Act I ──
def rule30_row(prev):
    """Generate next row using Wolfram Rule 30."""
    n = len(prev)
    row = [0] * n
    for i in range(n):
        l = prev[(i - 1) % n]
        c = prev[i]
        r = prev[(i + 1) % n]
        pattern = (l << 2) | (c << 1) | r
        row[i] = (30 >> pattern) & 1
    return row

def generate_rule30_grid(rows=20, cols=60):
    """Generate Rule 30 CA grid as list of rows."""
    grid = []
    first = [0] * cols
    first[cols // 2] = 1
    grid.append(first)
    for _ in range(rows - 1):
        grid.append(rule30_row(grid[-1]))
    return grid

# ── Rule 90 Pattern (Sierpinski) — Acts II & IV ──
def rule90_row(prev):
    """Generate next row using Wolfram Rule 90 (XOR of neighbors)."""
    n = len(prev)
    row = [0] * n
    for i in range(n):
        l = prev[(i - 1) % n]
        r = prev[(i + 1) % n]
        row[i] = l ^ r
    return row

def generate_rule90_grid(rows=20, cols=60):
    """Generate Rule 90 CA grid (Sierpinski triangle)."""
    grid = []
    first = [0] * cols
    first[cols // 2] = 1
    grid.append(first)
    for _ in range(rows - 1):
        grid.append(rule90_row(grid[-1]))
    return grid

# ── Rule 110 Pattern (Turing-complete) — Acts III & V ──
def rule110_row(prev):
    """Generate next row using Wolfram Rule 110."""
    n = len(prev)
    row = [0] * n
    for i in range(n):
        l = prev[(i - 1) % n]
        c = prev[i]
        r = prev[(i + 1) % n]
        pattern = (l << 2) | (c << 1) | r
        row[i] = (110 >> pattern) & 1
    return row

def generate_rule110_grid(rows=20, cols=60):
    """Generate Rule 110 CA grid."""
    grid = []
    first = [0] * cols
    first[-1] = 1  # Rule 110 starts from right
    grid.append(first)
    for _ in range(rows - 1):
        grid.append(rule110_row(grid[-1]))
    return grid

# ── CA Grid to SVG ──
def ca_grid_to_svg(grid, cell_size=8, active_color="#E63329", inactive_color="#F0F0F0",
                   opacity=0.15, x_offset=0, y_offset=0):
    """Convert a CA grid to SVG rect elements."""
    rects = []
    for r, row in enumerate(grid):
        for c, val in enumerate(row):
            color = active_color if val else inactive_color
            alpha = opacity if val else opacity * 0.3
            x = x_offset + c * cell_size
            y = y_offset + r * cell_size
            rects.append(
                f'<rect x="{x}" y="{y}" width="{cell_size}" height="{cell_size}" '
                f'fill="{color}" opacity="{alpha}" />'
            )
    return "\n".join(rects)


