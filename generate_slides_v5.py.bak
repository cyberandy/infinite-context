def slide_01():
    """Act I — Title: Structure Is the Moat"""
    grid = generate_rule30_grid(rows=40, cols=80)
    ca = ca_grid_to_svg(grid, cell_size=12, opacity=0.08, x_offset=960, y_offset=200)
    # Add red wedge
    ca += f'''
    <polygon points="1920,0 1920,1080 1200,1080" fill="{TOKENS['red']}" opacity="0.12" />
    '''
    body = f"""
    <div class="section-label">SEO Week 2026</div>
    <h1 class="headline" style="font-size:96px; margin-top: 40px;">Structure Is<br>the Moat</h1>
    <p class="subhead" style="margin-top: 40px;">What the context explosion means for how AI<br>finds, navigates and ranks your content</p>
    <p class="byline">Andrea Volpini · WordLift</p>
    """
    return base_html(body, ca)

