  }}
  .col-item.active {{
    border-left-color: {TOKENS['red']};
    color: {TOKENS['fg']};
  }}
  .numbered-item {{
    display: flex;
    gap: 24px;
    margin-bottom: 40px;
    align-items: flex-start;
  }}
  .numbered-item .num {{
    font-size: 48px;
    font-weight: 800;
    color: {TOKENS['red']};
    line-height: 1;
    min-width: 60px;
  }}
  .numbered-item .text {{
    font-size: 26px;
    line-height: 1.5;
  }}
  .numbered-item .text strong {{
    font-size: 28px;
    display: block;
    margin-bottom: 4px;
  }}
  table {{
    width: 100%;
    border-collapse: collapse;
    margin-top: 32px;
    font-size: 22px;
  }}
  th {{
    text-align: left;
    padding: 16px 20px;
    border-bottom: 3px solid {TOKENS['fg']};
    font-weight: 700;
    font-size: 18px;
    text-transform: uppercase;
    letter-spacing: 1px;
  }}
  td {{
    padding: 14px 20px;
    border-bottom: 1px solid {TOKENS['gray_light']};
    vertical-align: top;
  }}
  tr.highlight td {{
    background: #FFF5F5;
    font-weight: 700;
  }}
  .section-label {{
    font-size: 14px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 4px;
    color: {TOKENS['red']};
    margin-bottom: 16px;
  }}
  .big-quote {{
    font-size: 36px;
    font-weight: 700;
    line-height: 1.4;
    max-width: 1400px;
  }}
  .step-box {{
    background: {TOKENS['gray_light']};
    padding: 28px 32px;
    margin-bottom: 20px;
    border-left: 5px solid {TOKENS['red']};
  }}
  .step-box .step-label {{
    font-size: 14px;
