  .accent-wedge {{
    position: absolute;
    z-index: 0;
  }}
  .two-col {{
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    margin-top: 48px;
    flex: 1;
  }}
  .col-label {{
    font-size: 18px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 3px;
    color: {TOKENS['gray']};
